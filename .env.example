# Anthropic Claude
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# CORS: dominios permitidos para incrustar el widget (app/static/widget.js) en
# sitios de clientes, separados por coma. Ejemplo:
#   ALLOWED_ORIGINS=https://cliente1.com,https://cliente2.com
# Si se deja vacia/sin definir, se permite cualquier origen ("*") -- comodo
# para probar el widget en local, pero en produccion debe restringirse a los
# dominios reales de los clientes que incrustan el widget.
ALLOWED_ORIGINS=
